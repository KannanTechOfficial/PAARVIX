# ===== Paarvix Environment Configuration =====
# Copy to .env and fill in real values. NEVER commit .env!

# Database
DATABASE_URL=postgresql://paarvix:paarvix_secret@localhost:5432/paarvix

# Auth
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (for data source credentials)
PAARVIX_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key

# Server
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200

# SMTP (for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@paarvix.local

# AI (optional, BYO key)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Telemetry (opt-in)
TELEMETRY_ENABLED=false
