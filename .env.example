# ===== Paarvix Environment Configuration =====
# Copy to .env and fill in real values. NEVER commit .env!

# Database
DATABASE_URL=postgresql://paarvix:paarvix_secret@localhost:5432/paarvix

# Auth
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_EXPIRY=15m
# A session ends after this long without use (renewal moves it forward)...
JWT_REFRESH_EXPIRY=7d
# ...and always this long after sign-in, however active.
SESSION_MAX_AGE=30d

# Encryption (for data source credentials)
PAARVIX_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key

# Server
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200

# SMTP (for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@paarvix.local

# AI (optional, BYO key)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Telemetry (opt-in)
TELEMETRY_ENABLED=false

# Google sign-in (optional). Create an OAuth client of type "Web application" and add the redirect URI
# <PUBLIC_URL>/api/auth/google/callback. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:4200

# Paarvix Pro or Enterprise licence key (optional). Without one, Paarvix runs as Community with every
# Community feature on. It can also be pasted in Administration → Licence, or read from a file.
# PAARVIX_LICENSE=
# PAARVIX_LICENSE_FILE=/run/secrets/paarvix-license
